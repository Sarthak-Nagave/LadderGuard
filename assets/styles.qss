QWidget {
    font-family: "Segoe UI", sans-serif;
    font-size: 11px;
    color: #202124;
    background-color: #FAFAFA;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #FAFAFA;
}

QFrame {
    border: none;
}

QLabel {
    color: #202124;
}

#HeaderPanel, #SummaryPanel, #ProjectPanel, #ProgressWidget, #ResultTable {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 10px;
}

#HeaderPanel {
    padding: 2px;
}

#WindowTitle {
    font-size: 24px;
    font-weight: 700;
    color: #F57C00;
}

#WindowSubtitle {
    font-size: 11px;
    color: #616161;
}

#SectionLabel {
    font-size: 14px;
    font-weight: 700;
    color: #202124;
}

#ProjectPathLabel {
    color: #202124;
    background: #FAFAFA;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
    padding: 4px 8px;
}

QPushButton {
    background-color: #FFFFFF;
    color: #202124;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 40px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #FFF3E0;
    border-color: #F57C00;
}

QPushButton:pressed {
    background-color: #FFE0B2;
}

#PrimaryButton {
    background-color: #F57C00;
    color: #FFFFFF;
    border: none;
}

#PrimaryButton:hover {
    background-color: #EF6C00;
}

#SecondaryButton {
    background-color: #FFFFFF;
    color: #202124;
}

QProgressBar {
    border: 1px solid #E4E7EC;
    border-radius: 6px;
    background: #F5F5F5;
    min-height: 8px;
}

QProgressBar::chunk {
    background: #F57C00;
    border-radius: 6px;
}

#ProgressTitle {
    font-size: 14px;
    font-weight: 700;
    color: #202124;
}

#ProgressPercent {
    font-size: 16px;
    font-weight: 700;
    color: #202124;
}

#SummaryCard {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
    min-height: 46px;
}

#SummaryCard:hover {
    border-color: #F57C00;
}

#SummaryTitle {
    font-size: 10px;
    font-weight: 700;
    color: #616161;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

#SummaryValue {
    font-size: 18px;
    font-weight: 700;
    color: #202124;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 10px;
    gridline-color: #ECEFF3;
    selection-background-color: #FFE0B2;
    alternate-background-color: #F7F7F7;
}

QHeaderView::section {
    background-color: #FFFFFF;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #F57C00;
    color: #202124;
    font-weight: 700;
}

QTableWidget::item {
    padding: 6px;
    color: #202124;
}

QTableWidget::item:alternate {
    background-color: #F7F7F7;
}

QTableWidget::item:selected {
    background-color: #FFE0B2;
    color: #202124;
}

QStatusBar {
    background: #FAFAFA;
    color: #616161;
    border: none;
}

QScrollBar:vertical {
    background: #FAFAFA;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #D9DEE5;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #F57C00;
}
