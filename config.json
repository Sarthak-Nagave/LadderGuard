{
  "app": {
    "name": "Ladder Release Validator",
    "version": "1.0.0",
    "company_name": "Selec Controls Pvt. Ltd.",
    "organization_name": "Selec Controls Pvt. Ltd."
  },

  "paths": {
    "log_directory": "logs",
    "log_file_name": "validator.log",
    "report_directory": "reports",
    "report_name_prefix": "Validation_Report",
    "stylesheet_path": "assets/styles.qss",
    "icon_path": "assets/icons/app.ico",
    "default_output_filename": "Ladder_Chronology.xlsx",
    "document_validator_debug_log": "document_validator_debug.log",
    "default_folder_generation_target": "Desktop"
  },

  "project_structure": {
    "root_folder_name": "Ladder Release Structure",
    "required_folders": [
      "1. Ladders",
      "2. Bin File",
      "3. Operational Flow",
      "4. Test Report",
      "5. Automation Input Doc",
      "6. Ladder Flow",
      "7. Chronology"
    ],
    "folder_tree": {
      "1. Ladders": {},
      "2. Bin File": {},
      "3. Operational Flow": {},
      "4. Test Report": {},
      "5. Automation Input Doc": {},
      "6. Ladder Flow": {},
      "7. Chronology": {}
    },
    "ladder_initial_folder": "Initial",
    "ladder_final_folder": "Final",
    "bin_initial_folder": "Initial",
    "bin_final_folder": "Final"
  },

  "file_extensions": {
    "ladder_extension": ".sdoc",
    "bin_extension": ".bin",
    "supported_document_extensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx"],
    "supported_excel_extensions": [".xlsx", ".xlsm"]
  },

  "document_validation": {
    "signed_document_suffix": "-sgn",
    "document_validation_folders": [
      "3. Operational Flow",
      "4. Test Report",
      "5. Automation Input Doc",
      "6. Ladder Flow"
    ],
    "expected_signed_documents": 1,
    "required_sections_by_folder": {
      "3. Operational Flow": [
        {
          "section": "Prepared By",
          "aliases": ["Prepared By"]
        },
        {
          "section": "Checked By / Verified By",
          "aliases": ["Checked By", "Verified By"]
        },
        {
          "section": "Approved By",
          "aliases": ["Approved By"]
        }
      ],
      "4. Test Report": [
        {
          "section": "Prepared By",
          "aliases": ["Prepared By"]
        },
        {
          "section": "Checked By / Verified By",
          "aliases": ["Checked By", "Verified By"]
        },
        {
          "section": "Approved By",
          "aliases": ["Approved By"]
        }
      ],
      "5. Automation Input Doc": [
        {
          "section": "Prepared By",
          "aliases": ["Prepared By"]
        },
        {
          "section": "Checked By / Verified By",
          "aliases": ["Checked By", "Verified By"]
        },
        {
          "section": "Approved By",
          "aliases": ["Approved By"]
        }
      ],
      "6. Ladder Flow": [
        {
          "section": "Process Representative",
          "aliases": ["Process Representative"]
        },
        {
          "section": "Production / QC",
          "aliases": ["Production/QC", "Production QC"]
        },
        {
          "section": "HOD",
          "aliases": ["HOD"]
        }
      ]
    }
  },

  "folder_keys": {
    "ladders": "1. Ladders",
    "bin_file": "2. Bin File",
    "operational_flow": "3. Operational Flow",
    "test_report": "4. Test Report",
    "automation_input": "5. Automation Input Doc",
    "ladder_flow": "6. Ladder Flow",
    "chronology": "7. Chronology"
  },

  "search": {
    "recursive_search": true,
    "max_file_search_depth": 50
  },

  "crc": {
    "algorithm": "CRC32",
    "supported_algorithms": ["CRC16", "CRC32", "CRC32C", "CRC64"]
  },

  "gui": {
    "window_width": 1050,
    "window_height": 700,
    "min_window_width": 900,
    "min_window_height": 600
  },

  "theme": {
    "primary_color": "#F57C00",
    "success_color": "#2E7D32",
    "warning_color": "#ED6C02",
    "error_color": "#D32F2F",
    "background_color": "#FFFFFF",
    "card_background": "#F7F7F7"
  },

  "validation_limits": {
    "expected_ladder_files": 1,
    "expected_bin_files": 1
  },

  "threading": {
    "worker_timeout_seconds": 300
  }
}
