    "project_structure": {
      "root_folder_name": "Operational Package Structure",
      "required_folders": [
        "1. Ladders",
        "2. Bin File",
        "3. Operational Flow",
        "4. Test Report",
        "5. Automation Input Doc",
        "6. Ladder Flow",
        "7. Chronology"
      ],
      "folder_tree": {
        "1. Ladders": {},
        "2. Bin File": {},
