    "features": {
      "enable_crc": true,
      "enable_chronology": true,
      "enable_reports": true,
      "enable_pdf_validation": true,
      "enable_signature_validation": true,
      "developer_mode": false,
      "debug_mode": false
    },
    "rules": {
      "file_extensions": {
        "ladder_extension": ".sdoc",
        "bin_extension": ".bin",
        "supported_document_extensions": [
          ".pdf",
          ".doc",
          ".docx",
          ".xls",
          ".xlsx"
        ],
        "supported_excel_extensions": [
          ".xlsx",
          ".xlsm"
        ],
        "supported_firmware_extensions": [
          ".bin"
        ],
        "supported_ladder_extensions": [
          ".sdoc"
        ]
      }
    }
  },
